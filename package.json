{
  "name": "@aidev/ui-crawl",
  "version": "0.2.0",
  "private": true,
  "description": "Agent-native UI inspection instrument. Crawls a web app for visual, layout, contrast, accessibility, and interaction defects, and exposes a live browser session so an LLM harness can navigate and look. Emits JSON, indexed DOM snapshots, screenshots with source locations, and exact CSS remediations.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ui-crawl": "./bin/ui-crawl.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "crawl": "node bin/ui-crawl.js",
    "test": "vitest run",
    "test:live": "UI_CRAWL_LIVE=1 vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
